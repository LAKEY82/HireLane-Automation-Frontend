# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# All values are server-side only; none are sent to the browser.

# n8n instance (local: http://localhost:5678, hosted: https://lakindu-n8n.onrender.com)
N8N_BASE_URL=http://localhost:5678
# n8n → Settings → n8n API → Create API key
N8N_API_KEY=
# ID of the "QA Intern Applications" workflow (from its URL in n8n)
N8N_WORKFLOW_ID=KUiT8Dz3gTq48xAO
# Must equal the value of the n8n Header Auth credential "Frontend Webhook Secret" (header name X-Admin-Secret)
N8N_WEBHOOK_SECRET=

# Backup sign-in password for the admin frontend
ADMIN_PASSWORD=
# Auth.js session key: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Who may sign in (comma-separated). Domains cover any address at them;
# ALLOWED_EMAILS lists extra single addresses, e.g. a Gmail account.
ALLOWED_EMAIL_DOMAINS=theiavora.com
ALLOWED_EMAILS=

# "Continue with Google" (optional; hidden when empty). Also connects that Gmail to the workflow.
# Same Google Cloud OAuth client as n8n's Gmail login; redirect URI <app URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# "Continue with Microsoft" (optional; login only). Azure portal → App registrations;
# redirect URI <app URL>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
